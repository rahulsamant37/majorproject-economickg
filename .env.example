# =============================================================================
# AI-Powered Economic Knowledge Graph — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All keys are optional — the app starts with demo data if keys are missing.
# =============================================================================

# --- LLM Provider (pick one; OpenAI is preferred, Groq is fallback) ----------
OPENAI_API_KEY=
GROQ_API_KEY=

# --- News Ingestion ----------------------------------------------------------
NEWS_API_KEY=

# --- Neo4j Graph Database ----------------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- Optional: Aura-specific ------------------------------------------------
AURA_INSTANCEID=
AURA_INSTANCENAME=

# --- App Settings ------------------------------------------------------------
LOG_LEVEL=INFO
DEMO_SEED=true
